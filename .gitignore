# --- Sensitive research data (NEVER commit) ---
# Packet captures may contain device UIDs, tokens, MACs, and payloads
*.pcap
*.pcapng
*.cap
captures/*
!captures/.gitkeep

# Mobile app artifacts (APKs and everything decompiled out of them --
# these can contain keys, endpoints, and account identifiers)
*.apk
*.xapk
*.aab
*.dex
*.so
apk/
jadx-output/
apktool-output/
# Repackaging toolchain artifacts (large binaries / decompiled trees).
# tools/hook.js is kept; the jars/apks/decompiled dirs are not.
tools/*.jar
tools/splits/
tools/ubox-dec/
tools/*-dec/

# Firmware images and extractions
firmware/*
!firmware/.gitkeep
*.bin
_*.extracted/

# Secrets, credentials, tokens, keys
secrets/
.env
.env.*
*.key
*.pem
*.p12
credentials.json
tokens.json

# TLS interception exports
*.sslkeylog
sslkeys*.log

# --- Python ---
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- OS / editor ---
.DS_Store
*.swp
.idea/
.vscode/

# --- Local scratch ---
scratch/
tmp/
*.log
!docs/**/*.log

# Untracked device identity for the interop probes (UID, view password, IPs).
# Read by tools/p4p_probe_config.py; NEVER commit this.
local/

# Repackaging/Frida toolchain artifacts (may contain captured secrets)
tools/*.keystore
tools/*.idsig
tools/hooklog.txt
tools/*.output
